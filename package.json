{
  "name": "@forge-ahead/errors",
  "version": "0.3.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "main": "dist/index.mjs",
  "types": "dist/errors.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "lefthook run check",
    "clean": "npm run clean:build",
    "clean:build": "rm -rf ./dist ./coverage",
    "clean:install": "npm run clean:build && rm -rf package-lock.json ./node_modules ./cocoindex_code",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "pack:check": "npm run build && npm pack --dry-run --ignore-scripts",
    "prepare": "npm run build && (lefthook install || true)",
    "release:prepare": "scripts/release-prepare.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "neverthrow": "^8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.0",
    "lefthook": "^2.1",
    "tsdown": "^0.23",
    "typescript": "^5.9",
    "vitest": "^5.0"
  },
  "peerDependencies": {
    "vitest": "^5.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
